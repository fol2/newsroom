{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fol2/newsroom/.sdlc/focus-route.schema.json",
  "title": "Newsroom Focus Gate route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "base_sha",
    "head_sha",
    "base_tree_sha",
    "head_tree_sha",
    "changed_paths",
    "gates",
    "selected_tests",
    "selected_service_tests",
    "research_required",
    "full_health_required",
    "owner_authority_required",
    "bootstrap_required",
    "reasons",
    "execution_budget",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "newsroom.sdlc.focus-route.v1"
    },
    "contract_version": {
      "const": "focus-gates-v1"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_tree_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "F0"
      },
      "items": {
        "enum": [
          "F0",
          "F1",
          "F2",
          "F3",
          "F4"
        ]
      }
    },
    "selected_tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selected_service_tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_required": {
      "type": "boolean"
    },
    "full_health_required": {
      "type": "boolean"
    },
    "owner_authority_required": {
      "type": "boolean"
    },
    "bootstrap_required": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_gate_jobs",
        "dependency_bootstraps"
      ],
      "properties": {
        "focus_gate_jobs": {
          "const": 1
        },
        "dependency_bootstraps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
