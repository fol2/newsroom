{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "newsroom.graphiti-sdk-no-tool-calibration.v1",
  "title": "Redacted Cursor SDK no-tool calibration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ordinal",
    "label",
    "prompt_class",
    "fixture_id",
    "prompt_chars",
    "prompt_bytes",
    "prompt_sha256",
    "schema_bytes",
    "schema_sha256",
    "route_option_digest",
    "isolation_digest",
    "environment_allow_list_digest",
    "sdk_version",
    "bridge_protocol",
    "model",
    "agent_id_sha256",
    "usage",
    "usage_status",
    "latency_ms",
    "json_valid",
    "semantic_fixture_result",
    "validator_version",
    "semantic_failure_codes",
    "entity_count",
    "fact_count",
    "key_set_digest",
    "stream_message_classes",
    "tool_call_count",
    "status",
    "isolation"
  ],
  "properties": {
    "schema_version": {
      "const": "newsroom.graphiti-sdk-no-tool-calibration.v1"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "label": {
      "type": "string"
    },
    "prompt_class": {
      "type": "string"
    },
    "fixture_id": {
      "type": "string"
    },
    "prompt_chars": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "route_option_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "isolation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_allow_list_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sdk_version": {
      "type": "string"
    },
    "bridge_protocol": {
      "type": "string"
    },
    "model": {
      "const": "composer-2.5"
    },
    "agent_id_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage_status": {
      "enum": [
        "PROVIDER_REPORTED",
        "UNREPORTED"
      ]
    },
    "latency_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "json_valid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "semantic_fixture_result": {
      "enum": [
        "PASS",
        "FAIL",
        "PENDING",
        "UNRESOLVED"
      ]
    },
    "validator_version": {
      "enum": [
        "newsroom.graphiti-sdk-no-tool-validator.v1",
        "newsroom.graphiti-sdk-no-tool-validator.v2",
        "newsroom.graphiti-sdk-no-tool-validator.v3"
      ]
    },
    "semantic_failure_codes": {
      "type": "array",
      "items": {
        "enum": [
          "DISPATCH_FAILED",
          "DUPLICATE_JSON_KEY",
          "EVIDENCE_CONTRACT_UNVERIFIABLE",
          "FIXTURE_EXPECTATION_INVALID",
          "INVALID_JSON",
          "INVALID_LOCAL_REFERENCE",
          "INVALID_TEMPORAL_VALUE",
          "INVALID_TOP_LEVEL",
          "MISSING_ENTITY_LIST",
          "MISSING_EVIDENCE_SEGMENT_IDS",
          "MISSING_EXPECTED_ENTITY",
          "MISSING_EXPECTED_OK",
          "MISSING_FACT_LIST",
          "MISSING_FACT_TEXT",
          "MISSING_RELATION_TYPE",
          "MISSING_TEMPORAL_KEYS",
          "MISSING_TIMESTAMP_LIST",
          "MISSING_VALID_AT",
          "MODEL_IDENTITY_MISMATCH",
          "MODEL_IDENTITY_UNREPORTED",
          "SCHEMA_VALIDATION_FAILED",
          "UNCLASSIFIED_CONTRACT_MISMATCH",
          "UNCLASSIFIED_RETAINED_FAILURE",
          "UNEXPECTED_NONEMPTY_ZERO"
        ]
      },
      "uniqueItems": true
    },
    "entity_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "fact_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "key_set_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stream_message_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tool_call_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "status": {
      "type": "string"
    },
    "failure": {
      "type": "string"
    },
    "usage": {
      "type": "object",
      "required": [
        "usage_basis",
        "input_tokens",
        "output_tokens",
        "cached_read_tokens",
        "cached_write_tokens",
        "total_tokens",
        "reasoning_tokens"
      ],
      "properties": {
        "usage_basis": {
          "enum": [
            "PROVIDER_REPORTED",
            "UNREPORTED"
          ]
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_read_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_write_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "isolation": {
      "type": "object",
      "required": [
        "hook_count",
        "tool_count",
        "mcp_count",
        "subagent_count",
        "custom_tool_count",
        "prior_message_count",
        "prior_store_entry_count",
        "setting_sources",
        "cwd_empty",
        "cwd_has_git",
        "home_cursor_entry_count",
        "cwd_cursor_entry_count",
        "unclassified_cursor_entry_count",
        "environment_allow_list"
      ],
      "properties": {
        "hook_count": {
          "type": "integer",
          "const": 0
        },
        "tool_count": {
          "type": "integer",
          "const": 0
        },
        "mcp_count": {
          "type": "integer",
          "const": 0
        },
        "subagent_count": {
          "type": "integer",
          "const": 0
        },
        "custom_tool_count": {
          "type": "integer",
          "const": 0
        },
        "prior_message_count": {
          "type": "integer",
          "const": 0
        },
        "prior_store_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "setting_sources": {
          "const": "OMITTED"
        },
        "cwd_empty": {
          "type": "boolean"
        },
        "cwd_has_git": {
          "type": "boolean"
        },
        "home_cursor_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "cwd_cursor_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "unclassified_cursor_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "environment_allow_list": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "tool_call_observation_basis": {
      "enum": [
        "NOT_DISPATCHED",
        "NOT_AVAILABLE_AFTER_DISPATCH_FAILURE",
        "NOT_EXPOSED_BY_AGENT_PROMPT",
        "OBSERVED_STREAM",
        "ROUTE_CONFIGURATION_ONLY"
      ]
    },
    "observed_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_identity_basis": {
      "enum": [
        "REQUEST_ONLY",
        "REQUEST_AND_CATALOGUE",
        "RUN_RESULT"
      ]
    },
    "fixture_validity": {
      "enum": [
        "VALID",
        "INVALID_ZERO_EXPECTATION"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validator_version": {
            "const": "newsroom.graphiti-sdk-no-tool-validator.v3"
          }
        },
        "required": [
          "validator_version"
        ]
      },
      "then": {
        "required": [
          "tool_call_observation_basis",
          "observed_model",
          "model_identity_basis",
          "fixture_validity"
        ]
      }
    }
  ]
}
